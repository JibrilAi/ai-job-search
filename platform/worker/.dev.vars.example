# Primary LLM provider -- OpenRouter's free-model router. Get a key at
# https://openrouter.ai/keys (no charge as long as you stick to :free /
# openrouter/free models).
OPENROUTER_API_KEY=sk-or-v1-...
# Fallback LLM provider, used only if OpenRouter fails. Free at
# https://aistudio.google.com/apikey with no billing attached, or paid tier
# with much higher limits if billing is attached.
GEMINI_API_KEY=...
SESSION_SECRET=change-me
MAGIC_LINK_SECRET=change-me
RESEND_API_KEY=re_...
# Cloudflare Turnstile secret key (dashboard.cloudflare.com -> Turnstile).
# Pair with VITE_TURNSTILE_SITE_KEY in frontend/.env. If unset, Turnstile
# verification is skipped -- fine for local dev, but set it before deploying.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
